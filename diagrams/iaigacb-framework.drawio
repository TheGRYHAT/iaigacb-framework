<mxfile host="app.diagrams.net" modified="2026-09-18T00:00:00.000Z" agent="claude" version="24.0.0" type="device">
  <diagram id="p1" name="1 — Framework">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;IAiGACB — Certification Framework&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;Two ladders and one rule. Systems are tiered by capability; operators are licensed by skill; a Tier-n system may only be sold to Level ≥ n.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="hT" value="SYSTEM TIERS — assigned to the AI by the Model Assessment Program" style="text;html=1;align=left;fontStyle=1;fontSize=12;fontColor=#1F8A9E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="420" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="hL" value="OPERATOR LEVELS — earned by the person or organization" style="text;html=1;align=right;fontStyle=1;fontSize=12;fontColor=#1F8A9E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="920" y="95" width="420" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="T4" value="&lt;b&gt;T4 · Restricted-Domain Flag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Any base tier + meaningful uplift in CBRN · bioengineering · offensive cyber at scale · autonomous weapons · critical-infrastructure control&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C62828;strokeWidth=2;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="T3" value="&lt;b&gt;T3 · Frontier Advanced&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Most-capable class from any lab. Long-horizon autonomy, self-directed research, multi-agent orchestration. &lt;i&gt;e.g. Mythos-class&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="T2" value="&lt;b&gt;T2 · Frontier Professional&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Current frontier general-purpose. Autonomous agents with tool use, code execution, browsing. &lt;i&gt;e.g. Opus 5-class, GPT-5-class&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F8A9E;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="T1" value="&lt;b&gt;T1 · General Assistant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Below frontier. Text/code/image assistance; no autonomous tool execution against production. &lt;i&gt;e.g. prior-generation, open-weight 70B-class&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#9AA8B5;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="420" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="L4" value="&lt;b&gt;L4 · Restricted-Domain Licensee&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Per domain. L3 + domain credential + background check + Org-L4 sponsor + domain board interview. Every provisioning needs a Use Registration.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C62828;strokeWidth=2;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;L3 · Licensed AI Systems Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Governs frontier deployments: evaluation, red-teaming, multi-agent, incident command. L2 + 3 yrs + endorsement + capstone.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="230" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;L2 · Licensed AI Professional&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Agents with tool access, RAG over company data, regulated data. One identity per agent. L1 + 1 yr + exam + 4-hour lab.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F8A9E;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="340" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;L1 · Licensed AI Operator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Anyone deploying AI in a business. Data handling, prompt injection, output verification, restricted domains. 60-item proctored exam.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#9AA8B5;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="420" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="rule" value="&lt;b&gt;THE SALE RULE&lt;/b&gt;&lt;br&gt;&lt;br&gt;A registered vendor may only provision a &lt;b&gt;Tier-n&lt;/b&gt; system to an operator holding &lt;b&gt;Level ≥ n&lt;/b&gt;.&lt;br&gt;&lt;br&gt;T4 additionally requires a matching domain endorsement and a filed &lt;b&gt;Use Registration&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Checked at point of sale via the Registry API. A serial is issued and bound to the certification." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B1F3A;strokeWidth=2;dashed=1;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="230" width="320" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="a4" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;strokeColor=#C62828;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#C62828;" edge="1" parent="1" source="T4" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4l" value="L4 only + Use Registration" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=11;fontColor=#C62828;" vertex="1" connectable="0" parent="a4"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="a1" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;strokeColor=#9AA8B5;strokeWidth=2;" edge="1" parent="1" source="T1" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1l" value="L1 or above" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=11;fontColor=#5B6B7A;" vertex="1" connectable="0" parent="a1"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="a3" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;strokeColor=#0B1F3A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="T3" target="rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3b" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;strokeColor=#0B1F3A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rule" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;strokeColor=#1F8A9E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="T2" target="rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2b" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;strokeColor=#1F8A9E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rule" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="hP" value="POINT OF SALE — every purchase and every upgrade" style="text;html=1;align=left;fontStyle=1;fontSize=12;fontColor=#1F8A9E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="575" width="500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Vendor checkout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;buyer enters certification number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;POST /v1/provision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Registry API · vendor key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cert active · level ≥ tier · T4: Use Registration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="600" y="600" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Serial issued&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-family:monospace&quot;&gt;IAI-S-T2-00042-0000123456-X&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bound to the certification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F8A9E;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="870" y="600" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Instance deployed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;own credential · own audit trail · traceable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1140" y="600" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0B1F3A;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0B1F3A;strokeWidth=2;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0B1F3A;strokeWidth=2;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0B1F3A;strokeWidth=2;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3x" value="403 LEVEL_INSUFFICIENT → no sale" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C62828;strokeWidth=1;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#C62828;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p3" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="690"/><mxPoint x="170" y="690"/></Array></mxGeometry></mxCell>

        <mxCell id="hI" value="INCIDENT — from serial to competent authority" style="text;html=1;align=left;fontStyle=1;fontSize=12;fontColor=#C62828;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="&lt;b&gt;Incident reported&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vendor or operator · T4 24h · T3 72h · T2 7d · T1 30d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="60" y="745" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="i2" value="&lt;b&gt;Registry lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;serial → operator · level · RLO · jurisdiction · Use Registration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C62828;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="330" y="745" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="i3" value="&lt;b&gt;Severity triage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;duty officer · S1–S4 · 4h for S1/S2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C62828;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="600" y="745" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="i4" value="&lt;b&gt;Competent authority notified&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;US: FBI + CISA · CA: RCMP · UK: NCA · EU: national CSIRT · AU: AFP · JP: NPA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#C62828;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="870" y="745" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="i5" value="&lt;b&gt;Post-incident review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Register / guardrail update · exam item generated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1140" y="745" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="ie1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ie4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="foot" value="Serial from the point-of-sale flow is the key the incident flow resolves. No search, no guessing — one lookup gives a name, a level and a phone number." style="text;html=1;align=left;fontSize=11;fontColor=#5B6B7A;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="1280" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p2" name="2 — Governance &amp; Money">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;IAiGACB — Governance &amp;amp; Money&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;Practitioners hold the pen. Vendors are heard, not voted. The regulated fund the regulator.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="board" value="&lt;b&gt;BOARD OF DIRECTORS — 15 seats&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;9 sitting CISOs (West Coast founding) · 5 cybersecurity faculty · 1 Executive Director (ex officio)&lt;br&gt;Year one voluntary · 3-year staggered terms · no vendor seats · equity cap · 12-month cooling-off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="700" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="vac" value="&lt;b&gt;Vendor Advisory Council&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;One seat per registered vendor (Safety Officer).&lt;br&gt;Reviews drafts. Comments published.&lt;br&gt;&lt;b&gt;No vote. No committee seat.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA8B5;dashed=1;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1">
          <mxGeometry x="1090" y="100" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="vace" value="heard" style="edgeStyle=none;html=1;endArrow=open;strokeColor=#9AA8B5;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#5B6B7A;" edge="1" parent="1" source="vac" target="board"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="c1" value="&lt;b&gt;Curriculum &amp;amp; Examination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;faculty chair · exam domains, item banks, pass marks, CE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Model Assessment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;“the regulators” · CISO chair · tier placements, Register, re-baseline, probe sets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F8A9E;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Registry &amp;amp; Incidents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CISO chair · serials, duty officer rota, authority notifications, privacy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F8A9E;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Ethics, Appeals &amp;amp; Enforcement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;faculty chair · appeals, breaches, suspension/revocation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Finance &amp;amp; Membership&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CISO chair · budget, fee schedule, vendor agreements, chapters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="940" y="250" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Governance &amp;amp; Nominations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chair · nominations, conflicts, bylaws&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0B1F3A;" edge="1" parent="1" source="board" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0B1F3A;" edge="1" parent="1" source="board" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0B1F3A;" edge="1" parent="1" source="board" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0B1F3A;" edge="1" parent="1" source="board" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0B1F3A;" edge="1" parent="1" source="board" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0B1F3A;" edge="1" parent="1" source="board" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="staff" value="&lt;b&gt;Professional staff (from Phase 2, paid by vendor fees)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;3 Lead Assessors (L3, red-team/eval background) · ~8 contracted L4 Domain Assessors · 3 Assessment Analysts · 3 Registry engineers · 2 exam ops · ED + 3 ops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#0B1F3A;" vertex="1" parent="1">
          <mxGeometry x="280" y="360" width="640" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#1F8A9E;" edge="1" parent="1" source="c2" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#1F8A9E;" edge="1" parent="1" source="c3" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="hM" value="WHO PAYS — fees switch on in Phase 2 (2028). Year one is free." style="text;html=1;align=left;fontStyle=1;fontSize=12;fontColor=#1F8A9E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="600" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="vend" value="&lt;b&gt;AI VENDORS — every one registers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Annual: &lt;b&gt;0.5% of AI revenue&lt;/b&gt; · floor $10k · cap $1M (hit at $200M) · over $1B: $1M + $250k per T3 system&lt;br&gt;Per assessment: T1 $15k · T2 $60k · T3 $250k · T4 flag $150k/domain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B1F3A;strokeColor=#0B1F3A;fontFamily=Helvetica;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="520" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;OPERATORS &amp;amp; ORGANIZATIONS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;L1 $150 · L2 $450 · L3 $950 · L4 $2,500/domain (+ annual maintenance)&lt;br&gt;Org-L1 $500 · Org-L2 $2.5k · Org-L3 $15k assessment · Org-L4 +$10k/domain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F8A9E;strokeColor=#1F8A9E;fontFamily=Helvetica;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="520" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="funds" value="&lt;b&gt;YEAR-2 BUDGET (illustrative)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Revenue ~$7.7M · Cost ~$6.3M incl. $1.5M reserve&lt;br&gt;&lt;br&gt;&lt;b&gt;Independence rules&lt;/b&gt;&lt;br&gt;No vendor &amp;gt; 25% of revenue · vendor fees → assessment, operator fees → exams · fee changes need ⅔ vote + 90 days notice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B1F3A;strokeWidth=2;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="360" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="fe1" value="funds the regulators" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0B1F3A;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#0B1F3A;" edge="1" parent="1" source="vend" target="funds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" value="funds the exams" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1F8A9E;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#1F8A9E;" edge="1" parent="1" source="ops" target="funds"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="chap" value="&lt;b&gt;INTERNATIONAL CHAPTERS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Adopt the framework verbatim · local assessors · local authority matrix · in-region Registry hosting&lt;br&gt;Keep 60% of operator/org fees · vendor fees stay central&lt;br&gt;&lt;br&gt;First targets: &lt;b&gt;Canada · UK · EU (one member state) · Australia · Japan&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF3;strokeColor=#9AA8B5;fontFamily=Helvetica;fontColor=#0B1F3A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="500" width="280" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="tl" value="&lt;b&gt;Phase 0 · Q4 2026&lt;/b&gt; entity, 15 seats, v1.0, sandbox &amp;nbsp;→&amp;nbsp; &lt;b&gt;Phase 1 · 2027&lt;/b&gt; voluntary year: free L1/L2 pilots, first vendors on sandbox, 0 fees &amp;nbsp;→&amp;nbsp; &lt;b&gt;Phase 2 · 2028&lt;/b&gt; fees on, staff hired, sale rule live, first T3 assessment &amp;nbsp;→&amp;nbsp; &lt;b&gt;Phase 3 · 2029+&lt;/b&gt; chapters, regulator recognition, insurance &amp;amp; procurement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA8B5;fontFamily=Helvetica;fontSize=11;fontColor=#0B1F3A;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="1280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="foot2" value="Two things gate everything: fifteen names on the board, and one vendor integrating the API. Everything else is sequencing." style="text;html=1;align=left;fontSize=11;fontColor=#5B6B7A;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="815" width="1280" height="20" as="geometry"/>
        </mxCell>
      </root>
